# Build/runtime base URL for the backend API. In dev the browser calls the
# backend directly; in prod leave this empty and rely on the same-origin
# `/v1` rewrite (see next.config.mjs) or the runtime override in public/config.js.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Origin the Next server proxies same-origin /v1 calls to (Docker service name).
BACKEND_URL=http://backend:8080

FRONTEND_PORT_DEV=5173
FRONTEND_PORT_PROD=3000
